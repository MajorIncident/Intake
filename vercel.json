{
  "buildCommand": "npm run verify:protected-cases",
  "outputDirectory": ".",
  "cleanUrls": true,
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "verify/**": true
    }
  },
  "ignoreCommand": "case \"$VERCEL_GIT_COMMIT_REF\" in main|verify/*) exit 1 ;; *) exit 0 ;; esac"
}
